# Anthropic API key — get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use for the chatbot
CLAUDE_MODEL=claude-sonnet-4-6

# Server port
PORT=3000

# Simple bearer token protecting the /admin dashboard API (change per deployment!)
ADMIN_TOKEN=change-me

# Path to the dealership white-label config
DEALERSHIP_CONFIG=./config/dealership.config.json
